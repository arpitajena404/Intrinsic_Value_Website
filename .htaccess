<IfModule mod_headers.c>
    # Prevent caching of HTML and JSON files so visitors always get the latest layout and data
    <FilesMatch "\.(html|htm|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

RewriteEngine On

# Redirect trailing slash to non-trailing slash for non-existent directories/files (SEO & routing fix)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/nikhil-gangil-indian-value-investor [NC]
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# Redirect old query-string blog URLs to clean /<slug> URLs
RewriteCond %{THE_REQUEST} \s/+(?:blog-detail\.html|blog-detail)\?post=([^&\s]+)\s [NC]
RewriteRule ^ /%1? [R=301,L]

# Rewrite clean blog URLs /<slug> to blog-detail.html?post=<slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
RewriteCond %{REQUEST_URI} !^/(workshop|invest_biz|vsl|css|js|assets|static|images|api) [NC]
RewriteRule ^([^/]+)/?$ blog-detail.html?post=$1 [QSA,L]

# Route raw asset requests back to the analytics subfolder
RewriteRule ^css/(.*)$ analytics/frontend/css/$1 [L]
RewriteRule ^js/(.*)$ analytics/frontend/js/$1 [L]
RewriteRule ^assets/(.*)$ analytics/frontend/assets/$1 [L]
RewriteRule ^static/(.*)$ analytics/frontend/assets/$1 [L]

# Route clean analytics page requests to their actual HTML files
RewriteCond %{DOCUMENT_ROOT}/analytics/frontend/pages/$1.html -f
RewriteRule ^analytics/([^/]+)/?$ analytics/frontend/pages/$1.html [L]

# Redirect /admin to the new admin URL
RewriteRule ^admin/?$ https://intrinsicvalueequity.in/invest_biz/admin.html [R=301,L]

# Redirect /nikhil-gangil-indian-value-investor to /nikhil-gangil-indian-value-investor/
RewriteRule ^nikhil-gangil-indian-value-investor$ /nikhil-gangil-indian-value-investor/ [R=301,L]

# Rewrite /nikhil-gangil-indian-value-investor/ to the HTML file
RewriteRule ^nikhil-gangil-indian-value-investor/$ nikhil-gangil-indian-value-investor.html [L]

# 1. External redirect: strip .html extension if requested directly
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internal rewrite: map clean URLs back to their corresponding .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
