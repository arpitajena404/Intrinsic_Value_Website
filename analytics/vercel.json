{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/frontend/(.*)",
      "dest": "frontend/$1"
    },
    {
      "src": "/dashboard",
      "dest": "frontend/pages/dashboard"
    },
    {
      "src": "/ranking-tool",
      "dest": "frontend/pages/ranking-tool"
    },
    {
      "src": "/monthly-market-analysis",
      "dest": "frontend/pages/monthly-market-analysis"
    },
    {
      "src": "/market-valuation-index",
      "dest": "frontend/pages/market-valuation-index"
    },
    {
      "src": "/upcycle-downcycle",
      "dest": "frontend/pages/upcycle-downcycle"
    },
    {
      "src": "/headwind-tailwind-indicator",
      "dest": "frontend/pages/upcycle-downcycle"
    },
    {
      "src": "/portfolio-review-tool",
      "dest": "frontend/pages/portfolio-review-tool"
    },
    {
      "src": "/intrinsic-theme",
      "dest": "frontend/pages/intrinsic-theme"
    },
    {
      "src": "/sip",
      "dest": "frontend/pages/sip"
    },
    {
      "src": "/swp",
      "dest": "frontend/pages/swp"
    },
    {
      "src": "/lumpsum",
      "dest": "frontend/pages/lumpsum"
    },
    {
      "src": "/xirr",
      "dest": "frontend/pages/xirr"
    },
    {
      "src": "/gawp",
      "dest": "frontend/pages/gawp"
    },
    {
      "src": "/tools",
      "dest": "frontend/pages/tools"
    },
    {
      "src": "/admin",
      "dest": "frontend/pages/admin"
    },
    {
      "src": "/",
      "dest": "frontend/pages/dashboard"
    }
  ]
}